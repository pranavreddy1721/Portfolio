# Rename this file to .env before running the server

# MongoDB Atlas connection string
MONGO_URI=mongodb+srv://<username>:<password>@cluster0.xxxxx.mongodb.net/portfolio

# Long random secret used to sign JWT tokens (only used for admin login)
JWT_SECRET=replace_this_with_a_long_random_secret_key

# Admin login credentials — this is the ONLY account, created automatically
# the first time the server runs, if it doesn't already exist in the DB
ADMIN_EMAIL=you@example.com
ADMIN_PASSWORD=choose_a_strong_password

# Port the backend server will run on
PORT=5000
